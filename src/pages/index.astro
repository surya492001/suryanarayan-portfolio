---
import Layout from '../layouts/Layout.astro';
import { site, experience, projects, skills, education, certifications, resumes, showResumes } from '../data/config';
---
<Layout>
  <div class="reading-progress" aria-hidden="true"></div>
  <header class="header">
    <a href="#top" class="identity" aria-label="Suryanarayan, home"><span class="monogram">s<span>.</span></span><span>Suryanarayan<span class="identity-last">Satheesh Pillai</span></span></a>
    <nav aria-label="Main navigation"><a href="#projects">Selected work</a><a href="#experience">Experience</a><a href="#about">About</a></nav>
    <a class="header-contact" href="#contact">Let’s connect <span>↗</span></a>
  </header>
  <main id="main">
    <section class="hero wrap" id="top">
      <div class="hero-topline"><span class="eyebrow"><span class="small-cross">✳</span> Software · Data · Business</span><span class="edition">PERSONAL PORTFOLIO / 2026</span></div>
      <div class="hero-grid">
        <div class="hero-copy">
          <p class="hello">Hi, I’m Suryanarayan.</p>
          <h1>Where code<br />meets <em>context.</em></h1>
          <p class="intro">Software engineer & business analyst. Three years building enterprise banking applications, with a background in business analytics and a growing focus on AI engineering.</p>
          <div class="hero-actions"><a class="button primary" href="#projects">Explore my work <span>↘</span></a><a class="text-link" href="#about">A little about me <span>→</span></a></div>
        </div>
        <div class="orbit-card" data-lens="development">
          <div class="orbit-top"><span class="eyebrow">Two perspectives. One practice.</span><span class="orbit-star" aria-hidden="true">✳</span></div>
          <div class="lens-switch" role="group" aria-label="Explore my focus"><button class="active" aria-pressed="true" data-lens-button="development">Development</button><button aria-pressed="false" data-lens-button="analytics">Analytics</button></div>
          <div class="orbital-art" aria-hidden="true"><div class="orbit-ring ring-one"></div><div class="orbit-ring ring-two"></div><div class="orbit-ring ring-three"></div><span class="orbit-center">{'{ }'}</span><span class="orbit-label label-one">C# / .NET</span><span class="orbit-label label-two">SQL SERVER</span><span class="orbit-dot"></span></div>
          <div class="orbit-bottom" aria-live="polite"><span class="eyebrow" id="lens-label">01 / BUILD</span><p id="lens-description">From requirements to production.</p><span id="lens-tools">Enterprise applications · REST APIs · Workflows</span></div>
        </div>
      </div>
      <div class="hero-foot"><span><span class="status-dot"></span> Previously at HDFC Bank <span class="muted">/ 2023–2026</span></span><a href="#projects">Scroll to explore <span>↓</span></a></div>
    </section>
    <div class="credentials-strip"><div class="wrap"><span>ASP.NET Core</span><span class="strip-star">✳</span><span>Power BI</span><span class="strip-star">✳</span><span>Microsoft Fabric</span><span class="strip-star">✳</span><span>LangGraph</span><span class="strip-star">✳</span><span>Business Analysis</span></div></div>
    <section class="section wrap" id="projects">
      <div class="section-heading"><div><p class="eyebrow section-kicker">01 / Selected work</p><h2>Built with purpose<span class="blue">.</span></h2></div><p>Applications, analytics and AI.<br />A look at the work behind the skills.</p></div>
      <div class="project-toolbar"><div class="filters" role="group" aria-label="Filter projects"><button class="active" data-filter="all" aria-pressed="true">All work <span>05</span></button><button data-filter="development" aria-pressed="false">Development</button><button data-filter="analytics" aria-pressed="false">Analytics</button><button data-filter="ai" aria-pressed="false">AI engineering</button></div><span id="project-count" class="eyebrow" aria-live="polite">5 projects</span></div>
      <div class="project-grid">
        {projects.map((p, i) => <article class={`project-card project-${p.category}`} data-category={p.category}>
          <div class="project-art" aria-hidden="true">
            <span class="art-index">/ 0{i + 1}</span><span class="art-type">{p.category === 'ai' ? 'AI ENGINEERING' : p.category.toUpperCase()}</span>
            {i === 0 ? <div class="agent-diagram"><span class="diagram-node">INCIDENT</span><span class="diagram-line"></span><span class="agent-core">B<span>✳</span></span><span class="diagram-line"></span><span class="diagram-node">EVIDENCE</span><span class="diagram-caption">INVESTIGATE → RETRIEVE → RECOMMEND</span></div> : i === 1 ? <div class="docs-art"><span class="doc-sheet back"></span><span class="doc-sheet front"><span class="doc-symbol">p.</span><i></i><i></i><i></i><b>✓</b></span><span class="art-caption">A simpler document journey.</span></div> : i === 2 ? <div class="chart-art"><span class="chart-axis">SLA / TAT</span><div class="bars">{[35,58,44,76,63,89,72,95].map(h=><i style={`--bar-height:${h}%`}></i>)}</div><span class="chart-caption">WORKFLOW → INSIGHT</span></div> : i === 3 ? <div class="pipeline-art"><span>Bronze<small>01 / INGEST</small></span><b>→</b><span>Silver<small>02 / REFINE</small></span><b>→</b><span>Gold<small>03 / INSIGHT</small></span></div> : <div class="linen-art"><span class="linen-line"></span><span class="linen-word">nivara<small>L I V I N G</small></span><span class="linen-line"></span></div>}
          </div>
          <div class="project-content"><p class="eyebrow project-date">{p.date}</p><h3>{p.title}</h3><p class="project-subtitle">{p.subtitle}</p><p class="project-description">{p.description}</p><div class="tags">{p.stack.map(t=><span>{t}</span>)}</div><details><summary>Inside the project <span>+</span></summary><div class="project-detail"><p>{p.detail}</p><p class="project-outcome">↳ {p.outcome}</p>{p.link && <a class="text-link" href={p.link} target="_blank" rel="noopener noreferrer">Visit project ↗</a>}</div></details></div>
        </article>)}
      </div>
    </section>
    <section class="experience-section" id="experience"><div class="wrap section">
      <div class="section-heading"><div><p class="eyebrow section-kicker">02 / Experience</p><h2>From requirements<br />to real-world delivery.</h2></div><span class="large-asterisk" aria-hidden="true">✳</span></div>
      <div class="experience-grid"><div class="job-heading"><span class="eyebrow">{experience.period}</span><h3>{experience.company}</h3><p>{experience.role}</p><span class="job-location">{experience.location}</span><div class="job-stats"><div><strong>3</strong><span>Enterprise applications</span></div><div><strong>60+</strong><span>Production deployments</span></div></div></div><ol class="job-points">{experience.points.map((point,i)=><li><span>0{i+1}</span><p>{point}</p></li>)}</ol></div>
    </div></section>
    <section class="section wrap" id="about">
      <div class="section-heading"><div><p class="eyebrow section-kicker">03 / A little about me</p><h2>A technical foundation.<br /><em>A business perspective.</em></h2></div><p>Engineering at NMIMS.<br />Business analytics at BITS Pilani.<br />Now exploring applied AI.</p></div>
      <div class="about-grid"><div class="education"><h3 class="eyebrow">Education</h3>{education.map(e=><div class="education-item"><span class="eyebrow muted">{e.period}</span><h4>{e.org}</h4><p>{e.title}</p><span class="grade">{e.note}</span></div>)}<div class="learning"><span class="eyebrow">↗ Currently learning</span><h4>Forward Deployed AI Engineering</h4><p>Advanced Executive Program<br />IIT Madras Pravartak · Ongoing</p></div></div><div class="toolkit"><h3 class="eyebrow">My toolkit</h3>{skills.map((s,i)=><details open={i===0} class="skill-group"><summary><span><small>0{i+1}</small>{s.group}</span><b>+</b></summary><div class="skill-items">{s.items.map(t=><span>{t}</span>)}</div></details>)}<details class="certifications"><summary>Certifications <span>+</span></summary><ul>{certifications.map(c=><li>{c}</li>)}</ul></details><a class="publication" href="https://ieeexplore.ieee.org/document/10393129" target="_blank" rel="noopener noreferrer"><span class="eyebrow">Publication / ICACTA 2023</span><p>Probability of Heart Disease using Various Machine Learning Algorithms <span>↗</span></p></a></div></div>
    </section>
    <section id="contact" class="contact-section"><div class="wrap"><p class="eyebrow">04 / Get in touch</p><div class="contact-heading"><h2>Let’s start a<br /><em>conversation.</em></h2><a href={`mailto:${site.email}`} class="contact-arrow" aria-label="Email Suryanarayan">↗</a></div><div class="contact-bottom"><div><a class="email-link" href={`mailto:${site.email}`}>{site.email}</a><button id="copy-email" aria-label="Copy email address" data-email={site.email}>Copy email <span>⧉</span></button><span id="copy-status" role="status"></span></div><div class="social-links"><a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div>{showResumes && <div class="resume-row"><span class="eyebrow">Take a closer look</span>{resumes.map(r=><a href={r.file} download>{r.label}<span>PDF ↓</span></a>)}</div>}
      <form action="https://api.web3forms.com/submit" method="POST" class="contact-form">
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New message from your portfolio site" />
        <input type="hidden" name="from_name" value="Portfolio site" />
        <input type="checkbox" name="botcheck" hidden tabindex="-1" aria-hidden="true" />
        <div class="contact-form-fields">
          <label><span class="eyebrow">Name</span><input name="name" type="text" required autocomplete="name" placeholder="Your name" /></label>
          <label><span class="eyebrow">Email</span><input name="email" type="email" required autocomplete="email" placeholder="you@company.com" /></label>
        </div>
        <label><span class="eyebrow">Message</span><textarea name="message" rows="4" required placeholder="Tell me about the role or what you have in mind."></textarea></label>
        <button type="submit" class="button primary">Send message <span aria-hidden="true">↗</span></button>
      </form>
    </div></section>
  </main>
  <footer class="wrap"><a href="#top" class="footer-name">Suryanarayan Satheesh Pillai<span>Software engineer & business analyst</span></a><span>© {new Date().getFullYear()}</span><a href="#top">Back to top ↑</a></footer>
  <script>
    const lensCard = document.querySelector<HTMLElement>('.orbit-card');
    document.querySelectorAll<HTMLButtonElement>('[data-lens-button]').forEach(button => button.addEventListener('click', () => {
      const analytics = button.dataset.lensButton === 'analytics';
      if (lensCard) lensCard.dataset.lens = button.dataset.lensButton;
      document.querySelectorAll('[data-lens-button]').forEach(b => {b.classList.toggle('active', b === button); b.setAttribute('aria-pressed', String(b === button));});
      const setText = (selector: string, text: string) => { const el = document.querySelector(selector); if(el) el.textContent = text; };
      setText('.orbit-center', analytics ? '∑' : '{ }'); setText('.label-one', analytics ? 'POWER BI' : 'C# / .NET'); setText('.label-two', analytics ? 'FABRIC / SQL' : 'SQL SERVER');
      setText('#lens-label', analytics ? '02 / UNDERSTAND' : '01 / BUILD');
      setText('#lens-description', analytics ? 'From business questions to insights.' : 'From requirements to production.');
      setText('#lens-tools', analytics ? 'Requirements · Dashboards · Process analysis' : 'Enterprise applications · REST APIs · Workflows');
    }));
    document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button => button.addEventListener('click', () => {
      document.querySelectorAll('[data-filter]').forEach(b => { b.classList.toggle('active',b===button); b.setAttribute('aria-pressed',String(b===button)); });
      let count = 0;
      document.querySelectorAll<HTMLElement>('[data-category]').forEach(card => {card.hidden = button.dataset.filter !== 'all' && card.dataset.category !== button.dataset.filter; if(!card.hidden) count++;});
      const label = document.querySelector('#project-count'); if(label) label.textContent = `${count} project${count === 1 ? '' : 's'}`;
    }));
    document.querySelector<HTMLButtonElement>('#copy-email')?.addEventListener('click', async event => {
      const button = event.currentTarget as HTMLButtonElement;
      const status = document.querySelector('#copy-status');
      try { await navigator.clipboard.writeText(button.dataset.email ?? ''); if(status) status.textContent = 'Copied!'; }
      catch { if(status) status.textContent = 'Please select the email address to copy it.'; }
      window.setTimeout(() => {if(status) status.textContent = '';}, 4000);
    });
    const progress = document.querySelector<HTMLElement>('.reading-progress');
    const updateProgress = () => {if(progress) progress.style.transform = `scaleX(${window.scrollY / Math.max(1,document.documentElement.scrollHeight-window.innerHeight)})`;};
    window.addEventListener('scroll',updateProgress,{passive:true}); updateProgress();
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('nav a');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          navLinks.forEach(link => {
            const active = link.hash === `#${entry.target.id}`;
            link.classList.toggle('current', active);
            if (active) link.setAttribute('aria-current', 'location');
            else link.removeAttribute('aria-current');
          });
        });
      }, { rootMargin: '-15% 0px -65% 0px' });
      document.querySelectorAll('#projects, #experience, #about, #contact, #top').forEach(el => observer.observe(el));
    }
  </script>
</Layout>
