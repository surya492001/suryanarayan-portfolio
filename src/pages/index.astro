---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {
  site,
  hero,
  marquee,
  experience,
  education,
  certifications,
  projects,
  skills,
  publication,
  resumes,
} from '../data/config';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#resume', label: 'Resume' },
  { href: '#contact', label: 'Contact' },
];

// Split the headline on *emphasis* markers so the marked run renders in italic accent type.
const headlineParts = hero.headline.split(/(\*[^*]+\*)/g).filter(Boolean);

const marqueeRun = marquee.join(' · ');

const labelClass = 'text-[12px] font-medium tracking-[0.12em] text-muted uppercase';
---

<Layout>
  <!-- Static on phones (the wrapped nav would eat two rows of a small screen),
       sticky from tablet up where it fits on one line. -->
  <header
    class="z-40 border-b border-line-soft bg-bg/70 backdrop-blur-xl md:sticky md:top-0"
  >
    <div
      class="mx-auto flex max-w-[1180px] flex-wrap items-center justify-between gap-x-6 gap-y-3 px-[clamp(20px,5vw,64px)] py-4"
    >
      <a
        href="#top"
        class="group flex items-baseline gap-[0.42em] text-[clamp(15px,1.7vw,17.5px)] leading-tight whitespace-nowrap"
      >
        <span class="font-medium tracking-[0.015em] text-fg transition-colors group-hover:text-accent-light"
          >Suryanarayan</span
        >
        <span class="font-normal tracking-[0.06em] text-muted uppercase text-[0.78em] transition-colors group-hover:text-accent-light"
          >Satheesh Pillai</span
        >
      </a>
      <nav
        class="flex flex-wrap gap-x-[clamp(14px,2.2vw,28px)] gap-y-2 text-[12.5px] font-medium tracking-[0.1em] uppercase"
        aria-label="Main"
      >
        {
          nav.map((item) => (
            <a href={item.href} class="text-muted transition-colors hover:text-accent-light">
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </header>

  <div class="mx-auto max-w-[1180px] overflow-x-clip px-[clamp(20px,5vw,64px)] pb-[120px]">
    <main id="main">
      <!-- Hero -->
      <section id="top" class="scroll-mt-24 pt-[clamp(56px,10vw,120px)] pb-[clamp(48px,8vw,96px)]">
        <div
          class="mb-[clamp(28px,5vw,48px)] inline-flex items-center gap-2.5 rounded-full border border-accent/35 bg-accent/10 px-3.5 py-1.5"
        >
          <span class="relative flex h-2 w-2" aria-hidden="true">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"
            ></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
          </span>
          <span class="text-[12px] font-medium tracking-[0.12em] text-accent-light uppercase">
            {site.availability}
          </span>
        </div>

        <h1
          class="m-0 max-w-[16ch] font-serif text-[clamp(42px,7.4vw,104px)] leading-[0.98] font-normal tracking-[-0.02em] text-fg text-pretty"
        >
          {
            headlineParts.map((part) =>
              part.startsWith('*') && part.endsWith('*') ? (
                <em class="text-accent-light italic">{part.slice(1, -1)}</em>
              ) : (
                <span set:html={part.replace(/&/g, '<span class="text-muted">&amp;</span>')} />
              )
            )
          }
        </h1>

        <div
          class="mt-[clamp(44px,7vw,80px)] grid gap-[clamp(24px,4vw,56px)] border-t border-line pt-8 lg:grid-cols-3"
        >
          <p class="m-0 max-w-[62ch] text-[16px] leading-[1.75] text-body lg:col-span-2">
            {hero.intro}
          </p>
          <dl class="surface m-0 grid gap-0 px-5 py-2">
            {
              hero.facts.map((fact, i) => (
                <div
                  class={`flex items-baseline justify-between gap-3 py-3 text-[13.5px] ${
                    i < hero.facts.length - 1 ? 'border-b border-line-soft' : ''
                  }`}
                >
                  <dt class="text-muted">{fact.label}</dt>
                  <dd class="m-0 font-medium text-fg">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Marquee -->
      <div
        class="marquee-mask mb-[clamp(72px,11vw,130px)] overflow-hidden rounded-xl border border-line-soft bg-fg/3 py-4"
        aria-hidden="true"
      >
        <div
          class="marquee-track flex w-max font-serif text-[clamp(19px,2.5vw,28px)] whitespace-nowrap text-muted"
        >
          <span class="pr-10">{marqueeRun} · </span>
          <span class="pr-10">{marqueeRun} · </span>
        </div>
      </div>

      <!-- Experience -->
      <section id="work" class="scroll-mt-24">
        <SectionHeading num="01" title="Experience" />

        {
          experience.map((job) => (
            <div class="reveal surface grid gap-[clamp(20px,4vw,48px)] p-[clamp(22px,3vw,34px)] lg:grid-cols-3">
              <div>
                <div class={labelClass}>{job.period}</div>
                <div class="mt-3 font-serif text-[clamp(26px,3vw,36px)] leading-[1.1] text-fg">
                  {job.company}
                </div>
                <div class="mt-2 text-[14.5px] text-body">{job.role}</div>
                <div class="mt-1 text-[13.5px] text-dim">{job.location}</div>
              </div>
              <div class="max-w-[66ch] lg:col-span-2">
                <p class="m-0 text-[16px] leading-[1.75] text-fg">{job.lead}</p>
                <ul class="m-0 mt-6 grid list-none gap-3.5 p-0 text-[15px] leading-[1.7] text-body">
                  {job.points.map((point) => (
                    <li class="grid grid-cols-[16px_1fr] gap-3">
                      <span class="mt-[13px] h-px w-3 bg-accent" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }

        <div
          class="reveal surface mt-5 grid gap-[clamp(20px,4vw,48px)] p-[clamp(22px,3vw,34px)] lg:grid-cols-3"
        >
          <div>
            <div class={labelClass}>Education</div>
            <div class="mt-3 font-serif text-[clamp(26px,3vw,36px)] leading-[1.1] text-fg">
              Academics
            </div>
          </div>
          <div class="grid gap-6 lg:col-span-2">
            {
              education.map((e) => (
                <div>
                  <div class="text-[16px] text-fg">{e.title}</div>
                  <div class="mt-1.5 text-[14px] text-muted">
                    {e.org} · {e.period} · {e.note}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="reveal surface mt-5 grid gap-[clamp(20px,4vw,48px)] p-[clamp(22px,3vw,34px)] lg:grid-cols-3"
        >
          <div>
            <div class={labelClass}>Certifications</div>
            <div class="mt-3 font-serif text-[clamp(26px,3vw,36px)] leading-[1.1] text-fg">
              Credentials
            </div>
          </div>
          <div class="lg:col-span-2">
            <ul class="m-0 grid list-none gap-3 p-0 text-[15px] leading-[1.65] text-body">
              {
                certifications.map((c) => (
                  <li class="grid grid-cols-[16px_1fr] gap-3">
                    <span class="mt-[12px] h-px w-3 bg-accent" aria-hidden="true" />
                    <span>{c}</span>
                  </li>
                ))
              }
            </ul>
            <div class="mt-7 border-t border-line-soft pt-5">
              <div class={labelClass}>Publication</div>
              <p class="m-0 mt-2.5 max-w-[70ch] text-[14.5px] leading-[1.75] text-body">
                {publication.text}
              </p>
            </div>
          </div>
        </div>

        <p
          class="reveal m-0 mt-8 max-w-[54ch] font-serif text-[clamp(18px,2vw,22px)] italic text-muted"
        >
          Some client work is under confidentiality. Happy to walk through it verbally.
        </p>
      </section>

      <!-- Projects -->
      <section id="projects" class="scroll-mt-24 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="02" title="Projects" />

        <div class="grid gap-6">
          {
            projects.map((p, i) => (
              <article class="reveal surface surface-hover grid items-stretch gap-[clamp(20px,3.5vw,44px)] p-[clamp(22px,3vw,34px)] lg:grid-cols-3">
                <div class="flex min-h-[186px] flex-col justify-between gap-6 rounded-lg border border-line-soft bg-[linear-gradient(158deg,rgba(238,242,242,0.075),rgba(238,242,242,0.015))] p-[clamp(16px,2vw,20px)]">
                  <div class="flex items-start justify-between gap-3">
                    <span class="font-serif text-[clamp(30px,3.4vw,40px)] leading-none text-accent-light/75">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="rounded-full border border-amber/45 bg-amber/15 px-2.5 py-[3px] text-[11px] font-medium tracking-[0.09em] text-amber uppercase">
                      {p.tag}
                    </span>
                  </div>
                  <div>
                    <span class="text-[11px] font-medium tracking-[0.14em] text-dim uppercase">Stack</span>
                    <div class="mt-2.5 flex flex-wrap gap-1.5">
                      {p.stack.split('\u00b7').map((tech) => (
                        <span class="rounded border border-line-soft bg-bg/55 px-2 py-1 font-mono text-[11.5px] tracking-[0.02em] text-muted">
                          {tech.trim()}
                        </span>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="lg:col-span-2">
                  <h3 class="m-0 font-serif text-[clamp(24px,2.8vw,34px)] leading-[1.15] font-normal text-fg">
                    {p.title}
                  </h3>
                  <div class="mt-5 grid gap-4">
                    <div class="grid gap-x-4 gap-y-1 text-[15px] leading-[1.7] sm:grid-cols-[92px_1fr]">
                      <span class="pt-[4px] text-[11.5px] font-medium tracking-[0.1em] text-dim uppercase">
                        Problem
                      </span>
                      <span class="text-body">{p.problem}</span>
                    </div>
                    <div class="grid gap-x-4 gap-y-1 text-[15px] leading-[1.7] sm:grid-cols-[92px_1fr]">
                      <span class="pt-[4px] text-[11.5px] font-medium tracking-[0.1em] text-dim uppercase">
                        Approach
                      </span>
                      <span class="text-body">{p.approach}</span>
                    </div>
                    <div class="grid gap-x-4 gap-y-1 text-[15px] leading-[1.7] sm:grid-cols-[92px_1fr]">
                      <span class="pt-[4px] text-[11.5px] font-medium tracking-[0.1em] text-accent-light uppercase">
                        Impact
                      </span>
                      <span class="font-medium text-fg">{p.impact}</span>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Skills -->
      <section id="skills" class="scroll-mt-24 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="03" title="Skills" />
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
          {
            skills.map((g) => (
              <div class="reveal surface p-6">
                <div class="mb-5 border-b border-line-soft pb-4 font-serif text-[23px] text-fg">
                  {g.group}
                </div>
                <ul class="m-0 grid list-none gap-2.5 p-0">
                  {g.items.map((item) => (
                    <li class="text-[14.5px] leading-[1.5] text-body">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Resume -->
      <section id="resume" class="scroll-mt-24 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="04" title="Resume" />
        <div class="reveal grid gap-5 sm:grid-cols-2">
          {
            resumes.map((r) => (
              <a
                href={r.file}
                download
                class="surface surface-hover flex items-center justify-between gap-5 p-7"
              >
                <span>
                  <span class="block font-serif text-[27px] text-fg">{r.label}</span>
                  <span class="mt-2 block text-[13.5px] text-muted">{r.note}</span>
                </span>
                <span class="shrink-0 rounded-full border border-accent/45 bg-accent/12 px-3.5 py-1.5 text-[12px] font-medium tracking-[0.08em] text-accent-light uppercase">
                  PDF ↓
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="scroll-mt-24 pt-[clamp(72px,11vw,130px)]">
        <div class="reveal surface grid gap-[clamp(28px,5vw,56px)] p-[clamp(24px,4vw,48px)] lg:grid-cols-2">
          <div>
            <span class="text-[13px] font-medium tracking-[0.12em] text-accent-light">05</span>
            <h2
              class="m-0 mt-3 max-w-[14ch] font-serif text-[clamp(34px,6vw,64px)] leading-[1.02] font-normal tracking-[-0.02em] text-fg"
            >
              Let's talk about the role.
            </h2>
            <div class="mt-8 flex flex-wrap gap-3">
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-line px-5 py-2.5 text-[12.5px] font-medium tracking-[0.08em] text-fg uppercase transition-colors hover:border-accent hover:text-accent-light"
              >
                LinkedIn ↗
              </a>
              <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-line px-5 py-2.5 text-[12.5px] font-medium tracking-[0.08em] text-fg uppercase transition-colors hover:border-accent hover:text-accent-light"
              >
                GitHub ↗
              </a>
            </div>
          </div>

          <form action="https://api.web3forms.com/submit" method="POST" class="grid gap-5">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New message from your portfolio site" />
            <input type="hidden" name="from_name" value="Portfolio site" />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              aria-hidden="true"
            />

            <label class="grid gap-2">
              <span class={labelClass}>Name</span>
              <input
                name="name"
                type="text"
                required
                autocomplete="name"
                class="rounded-lg border border-line bg-bg/50 px-4 py-3 text-[15px] text-fg outline-none transition-colors placeholder:text-dim focus:border-accent"
                placeholder="Your name"
              />
            </label>
            <label class="grid gap-2">
              <span class={labelClass}>Email</span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                class="rounded-lg border border-line bg-bg/50 px-4 py-3 text-[15px] text-fg outline-none transition-colors placeholder:text-dim focus:border-accent"
                placeholder="you@company.com"
              />
            </label>
            <label class="grid gap-2">
              <span class={labelClass}>Message</span>
              <textarea
                name="message"
                rows="4"
                required
                class="resize-y rounded-lg border border-line bg-bg/50 px-4 py-3 text-[15px] leading-relaxed text-fg outline-none transition-colors placeholder:text-dim focus:border-accent"
                placeholder="A line or two about the role."></textarea>
            </label>
            <button
              type="submit"
              class="mt-1 cursor-pointer justify-self-start rounded-full border-0 bg-accent-light px-8 py-3.5 text-[13px] font-medium tracking-[0.08em] text-bg uppercase transition-opacity hover:opacity-90"
            >
              Send message
            </button>
          </form>
        </div>
      </section>
    </main>

    <footer
      class="mt-[clamp(72px,11vw,130px)] flex flex-wrap justify-between gap-3.5 border-t border-line pt-7 text-[13px] text-muted"
    >
      <span>{site.name} · {site.role}</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>
</Layout>
