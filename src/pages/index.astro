---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import {
  site,
  hero,
  marquee,
  experience,
  education,
  certifications,
  projects,
  skills,
  publication,
  resumes,
} from '../data/config';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#projects', label: 'Projects' },
  { href: '#skills', label: 'Skills' },
  { href: '#resume', label: 'Resume' },
  { href: '#contact', label: 'Contact' },
];

// Split the headline on *emphasis* markers so the marked run renders in italic accent type.
const headlineParts = hero.headline.split(/(\*[^*]+\*)/g).filter(Boolean);

const marqueeRun = marquee.join(' · ');
---

<Layout>
  <div class="mx-auto max-w-[1180px] overflow-x-clip px-[clamp(20px,5vw,64px)] pb-[120px]">
    <header class="flex flex-wrap items-baseline justify-between gap-5 pt-7">
      <a href="#top" class="font-serif text-[22px] tracking-[0.01em] transition-colors hover:text-accent-light">
        {site.shortName}
      </a>
      <nav
        class="flex flex-wrap gap-[clamp(14px,2.4vw,30px)] text-[12.5px] tracking-[0.09em] uppercase"
        aria-label="Main"
      >
        {
          nav.map((item) => (
            <a href={item.href} class="text-muted transition-colors hover:text-fg">
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main id="main">
      <!-- Hero -->
      <section id="top" class="pt-[clamp(64px,12vw,150px)] pb-[clamp(48px,8vw,96px)]">
        <div class="mb-[clamp(28px,5vw,48px)] flex items-center gap-3">
          <span
            class="h-2 w-2 rounded-full bg-accent shadow-[0_0_0_5px_oklch(0.62_0.17_205/0.18)]"
            aria-hidden="true"></span>
          <span class="text-[12.5px] tracking-[0.11em] text-muted uppercase">{site.availability}</span>
        </div>

        <h1
          class="m-0 max-w-[15ch] font-serif text-[clamp(42px,7.4vw,104px)] leading-[0.98] font-normal tracking-[-0.02em] text-pretty"
        >
          {
            headlineParts.map((part) =>
              part.startsWith('*') && part.endsWith('*') ? (
                <em class="text-accent-light italic">{part.slice(1, -1)}</em>
              ) : (
                <span set:html={part.replace(/&/g, '<span class="text-dim">&amp;</span>')} />
              )
            )
          }
        </h1>

        <div
          class="mt-[clamp(44px,7vw,84px)] grid gap-[clamp(24px,4vw,56px)] border-t border-line pt-7 sm:grid-cols-2 lg:grid-cols-3"
        >
          <p class="m-0 max-w-[62ch] text-[15.5px] leading-[1.7] text-body sm:col-span-2">
            {hero.intro}
          </p>
          <dl class="m-0 flex flex-col gap-3.5 text-[13px] tracking-[0.04em] text-muted">
            {
              hero.facts.map((fact, i) => (
                <div
                  class={`flex justify-between gap-3 ${
                    i < hero.facts.length - 1 ? 'border-b border-line-soft pb-2' : ''
                  }`}
                >
                  <dt>{fact.label}</dt>
                  <dd class="m-0 text-fg">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </section>

      <!-- Marquee -->
      <div
        class="mb-[clamp(72px,11vw,130px)] overflow-hidden border-y border-line py-3.5"
        aria-hidden="true"
      >
        <div
          class="marquee-track flex w-max font-serif text-[clamp(19px,2.5vw,28px)] whitespace-nowrap text-dim"
        >
          <span class="pr-10">{marqueeRun} · </span>
          <span class="pr-10">{marqueeRun} · </span>
        </div>
      </div>

      <!-- Experience -->
      <section id="work" class="scroll-mt-10">
        <SectionHeading num="01" title="Experience" />

        {
          experience.map((job) => (
            <div class="reveal grid gap-[clamp(20px,4vw,56px)] border-t border-line py-[clamp(24px,3vw,34px)] lg:grid-cols-3">
              <div>
                <div class="text-[13px] tracking-[0.08em] text-muted uppercase">{job.period}</div>
                <div class="mt-2.5 font-serif text-[clamp(24px,3vw,34px)] leading-[1.1]">
                  {job.company}
                </div>
                <div class="mt-1.5 text-sm text-muted">{job.role}</div>
                <div class="mt-1 text-sm text-dim">{job.location}</div>
              </div>
              <div class="max-w-[66ch] lg:col-span-2">
                <p class="m-0 text-[15.5px] leading-[1.75] text-body">{job.lead}</p>
                <ul class="m-0 mt-5 grid list-none gap-3 p-0 text-[14.5px] leading-[1.6] text-body">
                  {job.points.map((point) => (
                    <li class="grid grid-cols-[14px_1fr] gap-2.5">
                      <span class="mt-2.5 h-px w-2.5 bg-accent" aria-hidden="true" />
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))
        }

        <div
          class="reveal grid gap-[clamp(20px,4vw,56px)] border-t border-line py-[clamp(24px,3vw,34px)] lg:grid-cols-3"
        >
          <div>
            <div class="text-[13px] tracking-[0.08em] text-muted uppercase">Education</div>
            <div class="mt-2.5 font-serif text-[clamp(24px,3vw,34px)] leading-[1.1]">Academics</div>
          </div>
          <div class="grid gap-6 lg:col-span-2">
            {
              education.map((e) => (
                <div>
                  <div class="text-[15.5px] text-fg">{e.title}</div>
                  <div class="mt-1 text-sm text-muted">
                    {e.org} · {e.period} · {e.note}
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <div
          class="reveal grid gap-[clamp(20px,4vw,56px)] border-y border-line py-[clamp(24px,3vw,34px)] lg:grid-cols-3"
        >
          <div>
            <div class="text-[13px] tracking-[0.08em] text-muted uppercase">Certifications</div>
            <div class="mt-2.5 font-serif text-[clamp(24px,3vw,34px)] leading-[1.1]">Credentials</div>
          </div>
          <div class="lg:col-span-2">
            <ul class="m-0 grid list-none gap-2.5 p-0 text-[14.5px] leading-[1.6] text-body">
              {
                certifications.map((c) => (
                  <li class="grid grid-cols-[14px_1fr] gap-2.5">
                    <span class="mt-2.5 h-px w-2.5 bg-accent" aria-hidden="true" />
                    <span>{c}</span>
                  </li>
                ))
              }
            </ul>
            <p class="mt-6 max-w-[70ch] border-t border-line-soft pt-5 text-[13.5px] leading-[1.7] text-dim">
              <span class="tracking-[0.08em] text-muted uppercase">Publication</span>
              <br />
              {publication.text}
            </p>
          </div>
        </div>

        <p
          class="reveal m-0 mt-7 max-w-[52ch] font-serif text-[clamp(17px,2vw,21px)] italic text-dim"
        >
          Some client work is under confidentiality. Happy to walk through it verbally.
        </p>
      </section>

      <!-- Projects -->
      <section id="projects" class="scroll-mt-10 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="02" title="Selected projects" />

        <div class="grid gap-[clamp(28px,4vw,44px)]">
          {
            projects.map((p) => (
              <article class="reveal grid items-start gap-[clamp(20px,3.5vw,44px)] border-t border-line pt-[clamp(22px,3vw,32px)] lg:grid-cols-3">
                <div class="flex aspect-16/10 items-end border border-line bg-[repeating-linear-gradient(135deg,rgba(238,242,242,0.055)_0_2px,transparent_2px_9px)] p-3.5">
                  <span class="bg-bg px-[7px] py-1 font-mono text-[11px] tracking-[0.06em] text-dim">
                    {p.stack}
                  </span>
                </div>
                <div class="lg:col-span-2">
                  <div class="flex flex-wrap items-baseline gap-3">
                    <h3 class="m-0 font-serif text-[clamp(22px,2.8vw,32px)] leading-[1.15] font-normal">
                      {p.title}
                    </h3>
                    <span class="rounded-full border border-amber/50 bg-amber/12 px-2.5 py-[3px] text-[11.5px] tracking-[0.09em] text-amber uppercase">
                      {p.tag}
                    </span>
                  </div>
                  <div class="mt-[18px] grid gap-3.5">
                    <div class="grid gap-3.5 text-[14.5px] leading-[1.7] sm:grid-cols-[88px_1fr]">
                      <span class="pt-[5px] text-[11.5px] tracking-[0.09em] text-dim uppercase">Problem</span>
                      <span class="text-body">{p.problem}</span>
                    </div>
                    <div class="grid gap-3.5 text-[14.5px] leading-[1.7] sm:grid-cols-[88px_1fr]">
                      <span class="pt-[5px] text-[11.5px] tracking-[0.09em] text-dim uppercase">Approach</span>
                      <span class="text-body">{p.approach}</span>
                    </div>
                    <div class="grid gap-3.5 text-[14.5px] leading-[1.7] sm:grid-cols-[88px_1fr]">
                      <span class="pt-[5px] text-[11.5px] tracking-[0.09em] text-dim uppercase">Impact</span>
                      <span class="text-fg">{p.impact}</span>
                    </div>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Skills -->
      <section id="skills" class="scroll-mt-10 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="03" title="Skills" />
        <div class="grid gap-[clamp(24px,4vw,48px)] sm:grid-cols-2 lg:grid-cols-4">
          {
            skills.map((g) => (
              <div class="reveal border-t border-line pt-5">
                <div class="mb-4 font-serif text-[22px]">{g.group}</div>
                <ul class="m-0 grid list-none gap-[9px] p-0">
                  {g.items.map((item) => (
                    <li class="text-[14.5px] tracking-[0.01em] text-body">{item}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Resume -->
      <section id="resume" class="scroll-mt-10 pt-[clamp(72px,11vw,130px)]">
        <SectionHeading num="04" title="Resume" />
        <div class="reveal grid gap-[18px] sm:grid-cols-2">
          {
            resumes.map((r) => (
              <a
                href={r.file}
                download
                class="flex items-baseline justify-between gap-[18px] border border-line p-[26px] transition-colors hover:border-accent hover:bg-fg/4"
              >
                <span>
                  <span class="block font-serif text-[26px]">{r.label}</span>
                  <span class="mt-1.5 block text-[13px] text-muted">{r.note}</span>
                </span>
                <span class="shrink-0 text-xs tracking-[0.08em] text-accent-light uppercase">PDF ↓</span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="scroll-mt-10 pt-[clamp(72px,11vw,130px)]">
        <div
          class="reveal grid gap-[clamp(28px,5vw,64px)] border-t border-line pt-[clamp(28px,4vw,44px)] lg:grid-cols-2"
        >
          <div>
            <span class="text-xs tracking-[0.12em] text-accent-light">05</span>
            <h2
              class="m-0 mt-2.5 max-w-[14ch] font-serif text-[clamp(34px,6vw,64px)] leading-[1.02] font-normal tracking-[-0.02em]"
            >
              Let's talk about the role.
            </h2>
            <div class="mt-7 flex flex-wrap gap-[22px] text-[13px] tracking-[0.08em] uppercase">
              <a
                href={site.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="border-b border-fg/30 pb-[3px] transition-colors hover:text-accent-light"
              >
                LinkedIn
              </a>
              <a
                href={site.github}
                target="_blank"
                rel="noopener noreferrer"
                class="border-b border-fg/30 pb-[3px] transition-colors hover:text-accent-light"
              >
                GitHub
              </a>
            </div>
          </div>

          <form action="https://api.web3forms.com/submit" method="POST" class="grid gap-4">
            <input type="hidden" name="access_key" value={site.web3formsKey} />
            <input type="hidden" name="subject" value="New message from your portfolio site" />
            <input type="hidden" name="from_name" value="Portfolio site" />
            <input
              type="checkbox"
              name="botcheck"
              class="hidden"
              style="display:none"
              tabindex="-1"
              aria-hidden="true"
            />

            <label class="grid gap-[7px]">
              <span class="text-[11.5px] tracking-[0.1em] text-muted uppercase">Name</span>
              <input
                name="name"
                type="text"
                required
                autocomplete="name"
                class="border-0 border-b border-fg/22 bg-transparent py-2.5 text-[15px] text-fg outline-none focus:border-accent"
              />
            </label>
            <label class="grid gap-[7px]">
              <span class="text-[11.5px] tracking-[0.1em] text-muted uppercase">Email</span>
              <input
                name="email"
                type="email"
                required
                autocomplete="email"
                class="border-0 border-b border-fg/22 bg-transparent py-2.5 text-[15px] text-fg outline-none focus:border-accent"
              />
            </label>
            <label class="grid gap-[7px]">
              <span class="text-[11.5px] tracking-[0.1em] text-muted uppercase">Message</span>
              <textarea
                name="message"
                rows="4"
                required
                class="resize-y border-0 border-b border-fg/22 bg-transparent py-2.5 text-[15px] text-fg outline-none focus:border-accent"
              ></textarea>
            </label>
            <button
              type="submit"
              class="mt-2 cursor-pointer justify-self-start border-0 bg-fg px-7 py-[15px] text-[13px] tracking-[0.1em] text-bg uppercase transition-colors hover:bg-accent-light"
            >
              Send message
            </button>
            <span class="text-[12.5px] leading-[1.6] text-dim">
              Goes straight to my inbox via Web3Forms. No email address on the page for scrapers to
              harvest.
            </span>
          </form>
        </div>
      </section>
    </main>

    <footer
      class="mt-[clamp(72px,11vw,130px)] flex flex-wrap justify-between gap-3.5 border-t border-line pt-6 text-[12.5px] text-dim"
    >
      <span>{site.name} · {site.role}</span>
      <span>© {new Date().getFullYear()}</span>
    </footer>
  </div>
</Layout>
