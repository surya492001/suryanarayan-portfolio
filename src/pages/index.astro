---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Section from '../components/Section.astro';
import { site, about, experience, projects, skills, education, resumes } from '../data/config';
---

<Layout>
  <Nav />

  <main id="main">
    <!-- Hero -->
    <div id="top" class="relative overflow-hidden">
      <div
        class="pointer-events-none absolute -top-40 left-1/2 h-[32rem] w-[32rem] -translate-x-1/2 rounded-full bg-accent/8 blur-[120px]"
        aria-hidden="true"
      >
      </div>
      <div class="relative mx-auto max-w-5xl px-6 pt-24 pb-28 sm:pt-32 sm:pb-36 lg:px-8">
        {
          site.available && (
            <p class="reveal is-in inline-flex items-center gap-2 rounded-full border border-line px-3 py-1 text-xs text-muted">
              <span class="relative flex h-1.5 w-1.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-70" />
                <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent" />
              </span>
              Open to opportunities
            </p>
          )
        }

        <h1 class="reveal is-in mt-8 max-w-3xl font-serif text-5xl leading-[1.05] tracking-tight sm:text-6xl lg:text-7xl">
          {site.name}
        </h1>

        <p class="reveal is-in mt-6 max-w-2xl text-xl leading-relaxed text-muted sm:text-2xl">
          {site.headline}
        </p>

        <p class="reveal is-in mt-6 text-sm text-muted">{site.location}</p>

        <div class="reveal is-in mt-10 flex flex-wrap items-center gap-3">
          <a
            href="#contact"
            class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-ink transition-opacity hover:opacity-90"
          >
            Get in touch
          </a>
          {
            resumes.map((r) => (
              <a
                href={r.file}
                download
                class="rounded-full border border-line px-6 py-3 text-sm text-paper transition-colors hover:border-accent hover:text-accent"
              >
                {r.label}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- About -->
    <Section id="about" label="01 — About" title="Between the business and the build">
      <div class="space-y-5 text-lg leading-relaxed text-muted">
        {about.map((p) => <p>{p}</p>)}
      </div>
    </Section>

    <!-- Experience -->
    <Section id="experience" label="02 — Experience" title="Where I've worked">
      <div class="space-y-12">
        {
          experience.map((job) => (
            <article>
              <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
                <h3 class="text-lg text-paper">{job.role}</h3>
                <p class="text-sm text-muted">{job.period}</p>
              </div>
              <p class="mt-1 text-accent">{job.company}</p>
              <ul class="mt-5 space-y-3">
                {job.points.map((point) => (
                  <li class="flex gap-3 leading-relaxed text-muted">
                    <span class="mt-2.5 h-px w-4 shrink-0 bg-accent/60" aria-hidden="true" />
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }

        <div class="border-t border-line pt-8">
          <h3 class="text-sm uppercase tracking-[0.2em] text-muted">Education & certification</h3>
          <ul class="mt-5 space-y-4">
            {
              education.map((e) => (
                <li>
                  <p class="text-paper">{e.title}</p>
                  <p class="text-sm text-muted">
                    {e.org}
                    {e.period && ` · ${e.period}`}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </Section>

    <!-- Work -->
    <Section id="work" label="03 — Work" title="Selected work">
      <div class="space-y-px overflow-hidden rounded-lg border border-line">
        {
          projects.map((p) => (
            <article class="bg-ink-soft p-7 sm:p-8">
              <h3 class="font-serif text-2xl text-paper">{p.title}</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {p.tags.map((t) => (
                  <li class="rounded-full border border-line px-2.5 py-1 text-xs text-muted">{t}</li>
                ))}
              </ul>
              <dl class="mt-6 space-y-4">
                <div>
                  <dt class="text-xs uppercase tracking-[0.16em] text-accent">Problem</dt>
                  <dd class="mt-1.5 leading-relaxed text-muted">{p.problem}</dd>
                </div>
                <div>
                  <dt class="text-xs uppercase tracking-[0.16em] text-accent">Approach</dt>
                  <dd class="mt-1.5 leading-relaxed text-muted">{p.approach}</dd>
                </div>
                <div>
                  <dt class="text-xs uppercase tracking-[0.16em] text-accent">Impact</dt>
                  <dd class="mt-1.5 leading-relaxed text-muted">{p.impact}</dd>
                </div>
              </dl>
            </article>
          ))
        }
      </div>
      <p class="mt-6 text-sm leading-relaxed text-muted">
        Client work is described without naming internal systems. Some of it is under
        confidentiality — happy to walk through the detail verbally.
      </p>
    </Section>

    <!-- Skills -->
    <Section id="skills" label="04 — Skills" title="What I work with">
      <div class="grid gap-10 sm:grid-cols-3">
        {
          skills.map((s) => (
            <div>
              <h3 class="text-sm uppercase tracking-[0.16em] text-accent">{s.group}</h3>
              <ul class="mt-4 space-y-2 text-muted">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </Section>

    <!-- Contact -->
    <Section id="contact" label="05 — Contact" title="Let's talk">
      <p class="text-lg leading-relaxed text-muted">
        The fastest way to reach me is this form — it goes straight to my inbox. You'll also find
        me on LinkedIn and GitHub.
      </p>

      <form action="https://api.web3forms.com/submit" method="POST" class="mt-8 space-y-5">
        <input type="hidden" name="access_key" value={site.web3formsKey} />
        <input type="hidden" name="subject" value="New message from your portfolio site" />
        <input type="hidden" name="from_name" value={`${site.name} — portfolio`} />
        <input type="checkbox" name="botcheck" class="hidden" style="display:none" tabindex="-1" aria-hidden="true" />

        <div class="grid gap-5 sm:grid-cols-2">
          <label class="block">
            <span class="text-sm text-muted">Name</span>
            <input
              type="text"
              name="name"
              required
              autocomplete="name"
              class="mt-2 w-full rounded-md border border-line bg-ink-soft px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none"
              placeholder="Your name"
            />
          </label>
          <label class="block">
            <span class="text-sm text-muted">Email</span>
            <input
              type="email"
              name="email"
              required
              autocomplete="email"
              class="mt-2 w-full rounded-md border border-line bg-ink-soft px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none"
              placeholder="you@company.com"
            />
          </label>
        </div>

        <label class="block">
          <span class="text-sm text-muted">Message</span>
          <textarea
            name="message"
            rows="5"
            required
            class="mt-2 w-full resize-y rounded-md border border-line bg-ink-soft px-4 py-3 text-paper placeholder:text-muted/60 focus:border-accent focus:outline-none"
            placeholder="A line or two about the role or project."></textarea>
        </label>

        <button
          type="submit"
          class="rounded-full bg-accent px-6 py-3 text-sm font-medium text-ink transition-opacity hover:opacity-90"
        >
          Send message
        </button>
      </form>

      <div class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-line pt-8 text-sm">
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted transition-colors hover:text-accent">LinkedIn ↗</a
        >
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="text-muted transition-colors hover:text-accent">GitHub ↗</a
        >
      </div>
    </Section>
  </main>

  <footer class="border-t border-line">
    <div
      class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-6 py-10 text-sm text-muted lg:px-8"
    >
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p>Built with Astro · Hosted on Cloudflare Pages</p>
    </div>
  </footer>
</Layout>
