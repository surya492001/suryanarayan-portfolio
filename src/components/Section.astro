---
interface Props {
  id: string;
  label: string;
  title: string;
  class?: string;
}
const { id, label, title, class: cls = '' } = Astro.props;
---

<section id={id} class={`border-t border-line ${cls}`}>
  <div class="mx-auto max-w-5xl px-6 py-24 sm:py-32 lg:px-8">
    <div class="reveal grid gap-10 lg:grid-cols-[minmax(0,14rem)_minmax(0,1fr)] lg:gap-16">
      <div>
        <p class="text-xs uppercase tracking-[0.2em] text-accent">{label}</p>
        <h2 class="mt-4 font-serif text-3xl leading-tight text-paper sm:text-4xl">{title}</h2>
      </div>
      <div class="min-w-0">
        <slot />
      </div>
    </div>
  </div>
</section>
